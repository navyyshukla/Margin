#!/usr/bin/env bash
# Two gates, both enforced rather than documented:
#
#   1. No direct commits to main. Work happens on development; main only
#      receives reviewed merges. A rule in CLAUDE.md is a rule anyone (me or
#      Claude) can read past — this one cannot be read past.
#   2. The eval harness must pass when src/*.py is staged. A compression rule
#      that changes answers should not be committable in the first place.
#
# Bypass with `git commit --no-verify` if you ever genuinely need to; that
# should feel like a deliberate act, which is the point.

set -uo pipefail

branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  echo "pre-commit: refusing to commit directly to main." >&2
  echo "  Work on development; main takes reviewed merges only." >&2
  echo "  git switch development" >&2
  exit 1
fi

# Only run the harness when compression/eval code actually changed — plus
# bin/margin, which is not Python but is the launcher, and breaking its symlink
# resolution breaks the tool from every directory but the repo's own.
staged_src=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^(src/.*\.py|bin/margin)$' || true)
[ -n "$staged_src" ] || exit 0

repo_root=$(git rev-parse --show-toplevel)
PYTHON="$repo_root/.venv/bin/python"

# Test what is being COMMITTED, not what happens to be in the working tree.
#
# The two differ more often than it sounds: stage a good version, keep editing,
# then commit — or `git commit path/to/one/file` with others dirty — and the
# working tree is not the commit. A gate whose whole stated point is that it
# "cannot be read past" was validating code that was not going in.
#
# git checkout-index writes the staged content to a scratch directory. It only
# reads the index, so unlike `git stash` there is no way for it to lose work in
# the working tree if something here goes wrong.
STAGED_SRC=$(mktemp -d)
trap 'rm -rf "$STAGED_SRC"' EXIT
git checkout-index --prefix="$STAGED_SRC/" -a

# The samples are gitignored, so they are not in the index — point the harness at
# the real ones. They are inputs, not code under test.
SRC="$STAGED_SRC/src"
# Globbed, not listed: a payload added later would otherwise be silently
# unguarded. nullglob so an empty data/samples/ yields nothing, not the pattern.
shopt -s nullglob
SAMPLES=("$repo_root"/data/samples/*.json)

# The sample is gitignored and the venv is local, so a fresh checkout has
# neither. Missing inputs are not a regression — say so and allow the commit.
[ -x "$PYTHON" ] || { echo "pre-commit: eval harness skipped (no .venv)"; exit 0; }

# The property test needs no sample payload — it generates its own — so unlike
# the harness it still runs on a fresh checkout, where the gitignored samples
# are absent. That makes it the only gate a clone starts with.
echo "pre-commit: running property test (against the staged content)..."
if ! "$PYTHON" "$SRC/property_test.py"; then
  echo "" >&2
  echo "pre-commit: property test failed — commit refused." >&2
  echo "  The format broke on a generated payload. The printed payload is" >&2
  echo "  shrunk; paste it into MUST_TABULATE or MAY_DEGRADE once fixed." >&2
  exit 1
fi

# Also sample-free, so it runs here too. Note it tests $SRC — the staged copy —
# which is why cli_test.py locates cli.py relative to its own __file__ rather
# than to the repo root. Pointed at the repo it would grade the working tree
# while the commit went in unchecked.
echo "pre-commit: running CLI contract (against the staged content)..."
if ! "$PYTHON" "$SRC/cli_test.py"; then
  echo "" >&2
  echo "pre-commit: CLI contract failed — commit refused." >&2
  echo "  stdout is no longer pipe-clean, or an exit code moved." >&2
  exit 1
fi

# Sample-free too: it builds its own stored document in a temp directory. The
# third process boundary — cli_test covers argv, streams and exit codes; this
# covers JSON-RPC over a pipe, which is the only place the MCP protocol exists.
# It spawns the server with sys.executable, so it runs here, out of the staged
# scratch tree, with no .venv of its own.
echo "pre-commit: running MCP contract (against the staged content)..."
if ! "$PYTHON" "$SRC/mcp_test.py"; then
  echo "" >&2
  echo "pre-commit: MCP contract failed — commit refused." >&2
  echo "  The fetch tool no longer resolves handles, or it lost the batch," >&2
  echo "  query or truncation behaviour a reader depends on." >&2
  exit 1
fi

# Asks whether the gates above can still fail. Six checks in cli_test.py have
# gone green while the behaviour they were named for was deleted; this breaks
# each one on purpose and demands the matching check notice.
echo "pre-commit: running mutation coverage (against the staged content)..."
if ! "$PYTHON" "$SRC/mutation_test.py"; then
  echo "" >&2
  echo "pre-commit: a mutation survived — commit refused." >&2
  echo "  A CLI check no longer fails when its subject is broken, or the" >&2
  echo "  mutation's anchor text moved and it is now testing nothing." >&2
  exit 1
fi

for sample in "${SAMPLES[@]}"; do
  [ -f "$sample" ] || continue
  echo "pre-commit: running eval harness on $(basename "$sample")..."
  "$PYTHON" "$SRC/eval_harness.py" "$sample"
  status=$?
  # 3 = no questions for this payload yet: unfinished work, not a regression.
  # Allowed through, but said out loud on every commit until it is written.
  if [ "$status" -eq 3 ]; then
    echo "pre-commit: WARNING — $(basename "$sample") has no eval questions; unguarded."
  elif [ "$status" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: eval harness failed on $(basename "$sample") — commit refused." >&2
    echo "  A compression rule changed the answers, or broke the round-trip." >&2
    echo "  Fix the rule, or update the questions if a question was wrong." >&2
    exit 1
  fi
done
