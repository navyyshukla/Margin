__pycache__/
*.pyc
.venv/
.env
*.db
*.sqlite3

# sample data may contain real API responses from services you use —
# keep it local by default; un-ignore individual files you're sure are safe to share
data/samples/*
!data/samples/.gitkeep

# Model-eval runs: every response from every arm, so they quote the sample
# payloads back and are as private as those are. The *result* belongs in
# docs/status.md, where it can be read without re-running anything.
data/eval_runs/

# Emitted reading tasks: they embed the sample payloads verbatim, and the
# store and answer key alongside them. Same reason data/samples/ is ignored.
data/eval_tasks/

# Reading tasks for src/measure_miscount.py — regenerated by --emit, and the
# store they point at holds real payload content (same reason data/samples is
# ignored).
data/miscount_tasks/
data/.miscount-store/
